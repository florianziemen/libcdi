#!@SHELL@
@USE_MPI_FALSE@exit 77
@ENABLE_NETCDF_FALSE@exit 77

LOG=pio_cksum_cdf.log

if test 'x@ENABLE_NC4' = xyes; then
  suffix=nc4
  mpi_task_num=7
  pio_write_args="-f $suffix -w 3 -qtaxis-type=relative"
  . ./pio_write_run
fi

mpi_task_num=8
suffix=nc2
pio_write_args="-f $suffix -w 3 -qtaxis-type=relative"
. ./pio_write_run

mpi_task_num=5
suffix=nc
pio_write_args="-f $suffix -w 2 -qtaxis-type=relative"
. ./pio_write_run

#
# Local Variables:
# mode: sh
# End:
#
