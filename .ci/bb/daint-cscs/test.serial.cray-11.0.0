#!/bin/bash

set -eu

script_dir=$(cd "$(dirname "$0")"; pwd)
top_srcdir=$(cd "${script_dir}/../../.."; pwd)

. "${script_dir}/utils.sh"
init_cray1100

"${top_srcdir}/configure" \
--enable-cf-interface \
--enable-iso-c-interface \
--enable-option-checking=fatal \
--with-netcdf \
CC="${CC}" \
FC="${FC}" \

make -j8

make -j8 check

