# NetCDF
if (CDI_NETCDF)
  find_package(NetCDF COMPONENTS C)
  if (TARGET netCDF::netcdf)
    target_link_libraries(libcdi PUBLIC netCDF::netcdf)
    set(HAVE_LIBNETCDF 1)
  elseif (TARGET NetCDF::NetCDF)
    target_link_libraries(libcdi PUBLIC NetCDF::NetCDF)
    set(HAVE_LIBNETCDF 1)
  else ()
    message(STATUS "NetCDF not found: NetCDF support is disabled")
  endif ()
endif ()
