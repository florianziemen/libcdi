# NetCDF
if (CDI_NETCDF OR netCDF_ROOT)
  find_package(NetCDF COMPONENTS C REQUIRED)
  if (TARGET netCDF::netcdf)
    target_link_libraries(libcdi PUBLIC netCDF::netcdf)
    set(HAVE_LIBNETCDF 1)
  elseif (TARGET NetCDF::NetCDF)
    target_link_libraries(libcdi PUBLIC NetCDF::NetCDF)
    set(HAVE_LIBNETCDF 1)
  endif ()
endif ()
