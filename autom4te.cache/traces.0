         INTEGER, INTENT(in) :: i
         REAL, INTENT(in) :: v
         INTEGER, INTENT(out) :: p
         REAL, INTENT(out) :: q
         REAL :: f
       END FUNCTION cftstc
       FUNCTION chtst() result(s)
         CHARACTER(99) :: s
       END FUNCTION chtst
      END INTERFACE
