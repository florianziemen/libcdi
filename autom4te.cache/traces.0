     cat conftest.f | grep '/[[*]].*[[*]]/' >/dev/null 2>&1],
     [ac_cv_prog_fpp_cstyle=$ac_flag])
   FPPFLAGS=$ac_save_FPPFLAGS])
rm -f conftest*
AC_LANG_POP(Fortran)dnl
])
