      FCFLAGS=$FCFLAGS_save
      rm -rf conftestdir
      AS_VAR_SET_IF([mod_flag],dnl
        [m4_default([$1],[:])],dnl
        [m4_default([$2],[AC_MSG_ERROR([Cannot find flag to alter module search path])])])])
