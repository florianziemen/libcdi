export MPIROOT=/sw/sles10-x64/ofed/openmpi-1.4.0-nag52

export PATH=$MPIROOT/bin:$PATH

export LD_LIBRARY_PATH=$MPIROOT/lib:$LD_LIBRARY_PATH

export LD_LIBRARY_PATH=/sw/sles10-x64/szip-2.1/lib:$LD_LIBRARY_PATH 

mpiexec -x LD_LIBRARY_PATH pio_write_parallel 0
