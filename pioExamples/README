############################################################################
# on blizzard
#
# cdilib.c add preprocessor flags for Fortran interface routines by hand
####### parallel
#
### compile cdilib.c with mpi
#

mpcc_r -DHAVE_CF_INTERFACE -qlanglvl=stdc99 -g -O3 -q64 -qarch=auto -qtune=auto -DHAVE_MMAP -o cdilib_parallel -c cdilib.c -L/sw/aix53/szip-2.1/lib -lsz -L/sw/aix61/netcdf-4.0.1-ibm/lib -lnetcdf -L/sw/aix61/hdf5-1.8.4-patch1/lib -lhdf5_hl -lhdf5 -lz

#tau_cc.sh -DHAVE_CF_INTERFACE -qlanglvl=stdc99 -g -O3 -q64 -qarch=auto -qtune=auto -DHAVE_MMAP -o cdilib_parallel -c cdilib.c -L/sw/aix53/szip-2.1/lib -lsz -L/sw/aix61/netcdf-4.0.1-ibm/lib -lnetcdf -L/sw/aix61/hdf5-1.8.4-patch1/lib -lhdf5_hl -lhdf5 -lz

#
### compile example with mpi
#

mpxlf95_r -o cdi_write_parallel -I./ cdi_write_f.F90 cdilib_parallel  -L/sw/aix53/szip-2.1/lib -lsz -L/sw/aix61/netcdf-4.0.1-ibm/lib -lnetcdf -L/sw/aix61/hdf5-1.8.4-patch1/lib -lhdf5_hl -lhdf5 -lz

#tau_f90.sh -o cdi_write_parallel -I./ cdi_write_f.F90 cdilib_parallel  -L/sw/aix53/szip-2.1/lib -lsz -L/sw/aix61/netcdf-4.0.1-ibm/lib -lnetcdf -L/sw/aix61/hdf5-1.8.4-patch1/lib -lhdf5_hl -lhdf5 -lz

#
#
###### serial
#
### compile cdilib.c without mpi
#
xlc_r -DNOMPI -DHAVE_CF_INTERFACE -qlanglvl=stdc99 -g -O3 -q64 -qarch=auto -qtune=auto -DHAVE_MMAP -o cdilib_serial -c cdilib.c -L/sw/aix53/szip-2.1/lib -lsz -L/sw/aix61/netcdf-4.0.1-ibm/lib -lnetcdf -L/sw/aix61/hdf5-1.8.4-patch1/lib -lhdf5_hl -lhdf5 -lz
#
### compile example without mpi
#
xlf95_r -WF,-DNOMPI -o cdi_write_serial -I./ cdi_write_f.F90 cdilib_serial  -L/sw/aix53/szip-2.1/lib -lsz -L/sw/aix61/netcdf-4.0.1-ibm/lib -lnetcdf -L/sw/aix61/hdf5-1.8.4-patch1/lib -lhdf5_hl -lhdf5 -lz
#
###############################################################################


status quo:

ptypes available:

PIO_NONE                    0
PIO_MPI_NONB                1
PIO_POSIX_ASYNCH            2
PIO_POSIX_FPGUARD_SENDRECV  3
PIO_POSIX_NONB              4

initial_buffer_size = 16 * 1024 * 1024 bytes

usage of parallel version:

	define ptype
	init mpi
	init comm with only all i/o pes

	call int isCollector =  pioInit ( int ptype, int comm, int *ncollectors )

	if ( isCollector )
	{
	...
		call int streamID = streamOpenWrite ( const char * filename, int filetype )
	...
	 	call void streamWriteVar ( int streamID, int varID, const double *data, int nmiss )
	...
		call void streamClose ( int streamID )
	...
	}
	call void pioFinalize ()
	call mpi_finalize ()

	
