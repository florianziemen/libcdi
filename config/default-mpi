        --with-threads --without-grib_api --enable-cgribex --without-szlib  \
        --enable-iso-c-interface --enable-cf-interface --enable-mpi  \
        CC=/work/k20200/k202125/opt/spack/linux-rhel6-x86_64/gcc-7.1.0/openmpi-2.0.2p3-qigwpmjhtg443dv3lpkivhqq3xnqecbu/bin/mpicc  \
        FC=/work/k20200/k202125/opt/spack/linux-rhel6-x86_64/gcc-7.1.0/openmpi-2.0.2p3-qigwpmjhtg443dv3lpkivhqq3xnqecbu/bin/mpif90  \
        F77=/work/k20200/k202125/opt/spack/linux-rhel6-x86_64/gcc-7.1.0/openmpi-2.0.2p3-qigwpmjhtg443dv3lpkivhqq3xnqecbu/bin/mpif90  \
