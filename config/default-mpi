          MPI_LAUNCH="$(which srun) --propagate=STACK,CORE --exclusive" \
          --enable-mpi \
          --with-hdf5="${HDF5_ROOT}" \
          --with-netcdf="${NETCDF_C_ROOT}" \
          --with-szlib="${SZIP_ROOT}" \
