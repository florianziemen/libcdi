          LIBS="-lcurl -luuid" \
          BUILD_CFLAGS="-Wall -Wextra -Werror -Wno-error=unused-function" \
          LDFLAGS="${LDOPTFLAGS}"

          make && make check

          ;;
      intel16-impi512)
        os=x64-linux
        compiler=intel16
