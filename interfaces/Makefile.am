AM_CPPFLAGS = -I$(top_srcdir)/src

EXTRA_LTLIBRARIES = libcdipp.la
EXTRA_PROGRAMS = CdiInfo

libcdipp_la_SOURCES = cdi.cpp cdi.hpp
libcdipp_la_LIBADD = $(top_builddir)/src/libcdi.la

CdiInfo_SOURCES = CdiInfo.cpp
CdiInfo_LDADD = libcdipp.la

SWIG_FILE = $(srcdir)/cdi.i
MODULE_NAME = Cdi

all_local =
check_local =
install_exec_local =
uninstall_local =
clean_local =
MOSTLYCLEANFILES =
CLEANFILES =

if ENABLE_RUBY_INTERFACE
all_local += ruby-binding
check_local += ruby-test
install_exec_local += ruby-install
uninstall_local += ruby-uninstall
clean_local += ruby-clean
.PHONY: ruby-binding ruby-test ruby-install ruby-uninstall ruby-clean

V_MAKERUBY = $(v_MAKERUBY_@AM_V@)
v_MAKERUBY_ = $(v_MAKERUBY_@AM_DEFAULT_V@)
v_MAKERUBY_0 = 0
v_MAKERUBY_1 = 1

ruby-binding: ruby/$(MODULE_NAME).so

ruby/$(MODULE_NAME).so: ruby/cdi_wrapper.cpp ruby/Makefile libcdipp.la
	$(AM_V_GEN)$(am__cd) $(@D) && $(MAKE) $(AM_MAKEFLAGS) V='$(V_MAKERUBY)'

ruby/cdi_wrapper.cpp: @MAINTAINER_MODE_TRUE@ $(SWIG_FILE)
	$(AM_V_GEN)$(MKDIR_P) $(@D) && $(SWIG) -ruby -c++ -globalmodule -o $@ $(AM_CPPFLAGS) $(SWIG_FILE)

# TODO: the following is missing at least CXXFLAGS and CPPFLAGS:
ruby/Makefile: $(abs_srcdir)/ruby/setup.rb
	$(AM_V_GEN)$(MKDIR_P) $(@D) && $(am__cd) $(@D) && \
	INCFLAGS='-I$(abs_srcdir) -I$(abs_top_srcdir)/src' CFLAGS='$(CFLAGS)' LDFLAGS='$(LDFLAGS)' LIBS='$(LIBS)' $(RUBY) $<

ruby-test: $(srcdir)/ruby/test.rb mulval.nc
	@$(am__cd) ruby && $(RUBY) $(abs_srcdir)/ruby/test.rb

# We install the extension to the prefix of libcdi, not to the prefix of ruby.
# The users are supposed to extend the RUBYLIB environment variable with the
# path to the Cdi.so file (an architecture-specific subdirectory inside
# $(prefix)):
ruby-install: ruby-binding
	$(am__cd) ruby && $(MAKE) $(AM_MAKEFLAGS) install V='$(V_MAKERUBY)' prefix='$(DESTDIR)$(prefix)'

# TODO: come up with a robust way to uninstall the bindings:
ruby-uninstall:
	@echo 'WARNING: Ruby bindings have to be uninstalled manually' >&2

# We call with distclean to remove the generated ruby/Makefile, which is
# generated by this makefile, and should, therefore, be deleted with
# 'make clean':
ruby-clean:
	if test -f ruby/Makefile; then $(am__cd) ruby && $(MAKE) $(AM_MAKEFLAGS) distclean V='$(V_MAKERUBY)'; fi

MOSTLYCLEANFILES += ruby/$(MODULE_NAME).so
CLEANFILES += ruby/cdi_wrapper.cpp
endif ENABLE_RUBY_INTERFACE

if ENABLE_PYTHON_INTERFACE
all_local += python-binding
check_local += python-test
install_exec_local += python-install
uninstall_local += python-uninstall
clean_local += python-clean
.PHONY: python-binding python-test python-install python-uninstall python-clean

V_MAKEPYTHON = $(v_MAKEPYTHON_@AM_V@)
v_MAKEPYTHON_ = $(v_MAKEPYTHON_@AM_DEFAULT_V@)
v_MAKEPYTHON_0 = --quiet
v_MAKEPYTHON_1 = --verbose

python-binding: python/_$(MODULE_NAME).so

# TODO: the following is missing at least CXXFLAGS and CPPFLAGS:
python/_$(MODULE_NAME).so: $(abs_srcdir)/python/setup.py python/cdi_wrapper.cpp libcdipp.la
	$(AM_V_GEN)$(am__cd) $(@D) && \
	CC='$(CC)' CXX='$(CXX)' INCFLAGS='-I$(abs_srcdir) -I$(abs_top_srcdir)/src' CFLAGS='$(CFLAGS)' LDFLAGS='-L$(abs_top_builddir)/src/.libs $(LDFLAGS)' LIBS='$(LIBS)' LIBDIR='$(libdir)' BUILDLIBDIR='$(abs_top_builddir)/src/.libs' $(PYTHON) $< $(V_MAKEPYTHON) build_ext --inplace && touch $(@F)

python/cdi_wrapper.cpp: @MAINTAINER_MODE_TRUE@ $(SWIG_FILE)
	$(AM_V_GEN)$(MKDIR_P) $(@D) && $(SWIG) -python -c++ -o $@ $(AM_CPPFLAGS) $(SWIG_FILE)

python-test: $(srcdir)/python/test.py mulval.nc
	@$(am__cd) python && $(PYTHON) $(abs_srcdir)/python/test.py

# TODO: the following is missing at least CXXFLAGS and CPPFLAGS:
python-install: python-binding
	$(am__cd) python && \
	CC='$(CC)' CXX='$(CXX)' INCFLAGS='-I$(abs_srcdir) -I$(abs_top_srcdir)/src' CFLAGS='$(CFLAGS)' LDFLAGS='-L$(abs_top_builddir)/src/.libs $(LDFLAGS)' LIBS='$(LIBS)' LIBDIR='$(libdir)' $(PYTHON) setup.py $(V_MAKEPYTHON) install --prefix=$(prefix)

# TODO: come up with a robust way to uninstall the bindings:
python-uninstall:
	@echo 'WARNING: Python bindings have to be uninstalled manually' >&2

python-clean:
	$(am__cd) python && rm -rf *.pyc *.pyo __pycache__ build

MOSTLYCLEANFILES += python/_$(MODULE_NAME).so python/$(MODULE_NAME).py
CLEANFILES += python/cdi_wrapper.cpp
endif

all-local: $(all_local)
check-local: $(check_local)
install-exec-local: $(install_exec_local)
uninstall-local: $(uninstall_local)
clean-local: $(clean_local)

mulval.nc: $(srcdir)/mulval.nc.gz
	$(AM_V_GEN)gunzip -c $< > $@

MOSTLYCLEANFILES += libcdipp.la CdiInfo
CLEANFILES += mulval.nc

EXTRA_DIST = \
  $(SWIG_FILE) \
  f2003/bindGen.rb \
  mulval.nc.gz \
  python/setup.py \
  python/test.py \
  ruby/setup.rb \
  ruby/test.rb

# Compile programs using Libtool:
COMPILE = $(LTCOMPILE)
FCCOMPILE = $(LTFCCOMPILE)
PPFCCOMPILE = $(LTPPFCCOMPILE)
CXXCOMPILE = $(LTCXXCOMPILE)

# Compile *.F90 without CPPFLAGS, which are normally meant for the C compiler
# and might not be compatible with the Fortran compiler:
LTPPFCCOMPILE = $(LTFCCOMPILE)

# Avoid compiling twice by running Libtool with '-static'
#   This is safe because all Libtool libraries in this directory are
#   static-only and contain PIC objects:
LTCOMPILE = $(LIBTOOL) $(AM_V_lt) --tag=CC $(AM_LIBTOOLFLAGS) \
        $(LIBTOOLFLAGS) --mode=compile $(CC) -static $(DEFS) \
        $(DEFAULT_INCLUDES) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) \
        $(AM_CFLAGS) $(CFLAGS)
LINK = $(LIBTOOL) $(AM_V_lt) --tag=CC $(AM_LIBTOOLFLAGS) \
        $(LIBTOOLFLAGS) --mode=link $(CCLD) -static $(AM_CFLAGS) $(CFLAGS) \
        $(AM_LDFLAGS) $(LDFLAGS) -o $@
LTFCCOMPILE = $(LIBTOOL) $(AM_V_lt) --tag=FC $(AM_LIBTOOLFLAGS) \
        $(LIBTOOLFLAGS) --mode=compile $(FC) -static $(AM_FCFLAGS) $(FCFLAGS)
FCLINK = $(LIBTOOL) $(AM_V_lt) --tag=FC $(AM_LIBTOOLFLAGS) \
        $(LIBTOOLFLAGS) --mode=link $(FCLD) -static $(AM_FCFLAGS) $(FCFLAGS) \
        $(AM_LDFLAGS) $(LDFLAGS) -o $@
LTCXXCOMPILE = $(LIBTOOL) $(AM_V_lt) --tag=CXX $(AM_LIBTOOLFLAGS) \
        $(LIBTOOLFLAGS) --mode=compile $(CXX) -static $(DEFS) \
        $(DEFAULT_INCLUDES) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) \
        $(AM_CXXFLAGS) $(CXXFLAGS)
CXXLINK = $(LIBTOOL) $(AM_V_lt) --tag=CXX $(AM_LIBTOOLFLAGS) \
        $(LIBTOOLFLAGS) --mode=link $(CXXLD) -static $(AM_CXXFLAGS) \
        $(CXXFLAGS) $(AM_LDFLAGS) $(LDFLAGS) -o $@
